    "motion_uncertainty": {
      "executable": "current",
      "description": "Uncertainty hard gate and soft Mahalanobis cost; direction and endpoint recovery disabled.",
      "args": {
        "association": "motion",
        "motion_gate": 13.2767,
        "motion_mahalanobis_weight": 0.25,
        "motion_direction_weight": 0,
        "motion_recovery": 0,

  "matched_control": "Exact per-sequence realized K calls uniformly over N frames; clone all treatment association, motion, scene, risk_scope and output knobs, change only schedule and uniform_calls. Retrospective content-independent comparator, not causal online scheduling.",
  "timing_scope": "Cached association/scheduling quality only; no live FPS, new-detector training, or whole-pipeline generalization claim.",
  "amendments": [
    {
      "stage": "After initial strict-motion validation; before any fresh confirmation scoring",
      "reason": "Strict uncertainty gating regressed on raw insect validation, motivating a bounded high-IoU fallback. All original strict ablations and failures remain reported.",
      "added_profiles": [
        "motion_hybrid_iou",
        "motion_hybrid_full",
        "motion_hybrid_no_recovery"
      ],
      "selection_objective_unchanged": true,
      "confirmation_not_scored": true
    },
    {
      "stage": "After strict and hybrid motion validation, before any fresh confirmation scoring",
      "reason": "Global non-overlap edges can displace strong IoU matches. One final recovery-only association preserves the original two IoU passes before considering cautious unmatched high-score recovery.",
      "added_profiles": [
        "recovery"
      ],
      "selection_objective_unchanged": true,
      "confirmation_not_scored": true,
      "no_additional_grid": true
    },
    {
      "stage": "Before any confirmation scoring or freeze; after user requested5\u201310 more videos",
      "reason": "Expand confirmation beyond bees/insects to nine additional categories. Index2 except ball3/person0/stock1 to keep selected image archive bytes under300MB; no performance-based selection.",
      "confirmation_not_scored": true,
      "selection_objective_unchanged": true,

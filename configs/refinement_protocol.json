        "motion_mahalanobis_weight": 0.25,
        "motion_direction_weight": 0.1,
        "motion_recovery": 1,
        "motion_max_center_distance": 3,
        "motion_cost_limit": 1,
        "motion_ambiguity_margin": 0.03

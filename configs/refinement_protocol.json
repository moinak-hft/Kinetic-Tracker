        "association": "motion",
        "motion_gate": 13.2767,
        "motion_mahalanobis_weight": 0,
        "motion_direction_weight": 0.1,
        "motion_recovery": 0,
        "motion_max_center_distance": 3,
        "motion_cost_limit": 1,
        "motion_ambiguity_margin": 0.03
      },
      "selection_eligible": true

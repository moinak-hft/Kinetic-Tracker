{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kinetic: build and test",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}\\tools\\build.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Kinetic: regenerate report",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["tools/refinement_report.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
